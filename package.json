{
  "name": "gardendoku",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sync": "npm run build && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios",
    "icons": "capacitor-assets generate --android --ios",
    "level-points": "vite-node scripts/level-points.ts"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@electric-sql/pglite": "^0.5.12",
    "@types/three": "^0.170.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor-firebase/analytics": "^8.6.0",
    "@capacitor-firebase/remote-config": "^8.6.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@fontsource/fredoka": "^5.3.0",
    "@revenuecat/purchases-capacitor": "^14.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "firebase": "^12.19.0",
    "polygon-clipping": "^0.15.7",
    "three": "^0.170.0"
  }
}
